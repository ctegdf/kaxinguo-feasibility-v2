  "Skill_Definitions": {
    "MOVE_TO": {
      "description": "移动到一个地图目的地；不展开导航途经点。",
      "args": {
        "location_id": "语义地图 locations 中的稳定 ID"
      }
    },
    "FOLLOW": {
      "description": "跟随语义指代的对象，直到到达指定地图地点。",
      "args": {
        "target_ref": "原始或上下文补全后的语义指代表达，不生成人物 ID",
        "until_location_id": "跟随结束地点的地图 ID"
      }
    },
    "OBSERVE": {
      "description": "在当前位置用一个合法视角查询一个固定信息项；问题由公共程序按 view_id 与 field 生成。",
      "args": {
        "view_id": "地图中属于当前位置的视角ID",
        "field": "单个字段名，必须属于 Observation_Queries[view_id].questions"
      },
      "field_definitions": {
        "people_count": "指定视角中清楚可见的人数，非整个住宅或不可见区域的人数。",
        "people_descriptions": "同一视角中人物的自然语言外观描述，无 target_id。",
        "cup_visible": "指定观察区域中是否清楚可见杯子。",
        "tableware_visible": "指定餐桌区域中是否清楚可见摆放的餐具。",
        "notice_text": "画面中通知卡的原文；无卡时为空字符串。",
        "quiet_sign_visible": "书桌上是否清楚可见“请勿打扰”标识。",
        "visible_items": "所问区域中清楚可见的物品名称列表。"
      },
      "result": {
        "status": "SUCCESS",
        "data": {
          "location_id": "实际地点",
          "view_id": "实际视角",
          "field": "请求的单个字段",
          "value": "该字段的真实结果",
          "question": "程序生成的问题，仅供记录",
          "summary": "同一个结果的固定句式表述，用于播报；不增加观察信息"
        }
      }
    },
    "SAY": {
      "description": "语音播报给定文本；只在成功反馈后才记为已经播报。",
      "args": {
        "text": "非空播报文本；不隐含提问、等待或用户回复。"
      }
    }
  },
  "Shared_Protocol": {
    "scope": "NORMAL_EXECUTION_TASK_LOGIC_BRANCHING_ONLY",
    "skill_execution_assumption": "所有合法技能调用正常成功；不模拟执行失败、重试或不确定识别。非法参数及错误顺序仍属于规划问题。",
    "scene_assumption": "每个 episode 的场景事实由作者显式设定，在本目标的观察阶段保持不变；视角内目标清楚可见。",
    "perception_source": "SYNTHETIC_SEMANTIC_ORACLE_NO_IMAGES",
    "max_decisions_per_episode": 40,
    "end_control": {
      "decision": "FINISH",
      "outcome": "completed"
    },
    "control_note": "ASK 与 FINISH 是控制操作；物理技能仅 MOVE_TO、FOLLOW、OBSERVE、SAY。",
    "robot_message_rule": "模型动作文本不等于执行成功；必须读取 SUCCESS 反馈后继续。",
    "observation_rule": "一次 OBSERVE 只查询一个 field；到达对应地点后才返回本次 value。物品列表是一个信息项，不与人数等其他信息合并。",
    "map_rule": "地图地标不是当前场景事实；只使用地图可调用地点，不把 connected_to 展开为任务途经点。",
    "follow_rule": "规划层仅传递语义指代；人物身份消解与视觉 grounding 均不评分。",
    "dialogue_scope": "仅明确地点选择、继续或停止、语言跟随对象；不处理任意目标修改。",
    "protocol_version": "kaxinguo_feasibility_v1",
    "ask_channel": "INTERACTION_WINDOW",
    "replan_enabled": false,
    "unknown_observation_policy": "首轮可行性集不产生 UNCERTAIN。若实际输入超出此合同，停止本情境并标记 OUT_OF_SCOPE_INPUT，不映射为 false 或 0，也不计为模型规划错误。",
    "limit_counting": "每个已接受的 CALL、ASK、FINISH 各计一次；一体式 CONDITION 与容器不计物理动作，另记树节点数。",
    "completed_meaning": "只表示当前目标或生效分支已经实际满足；FINISH/END 是完成声明，不是独立正确性证明。"
  },
