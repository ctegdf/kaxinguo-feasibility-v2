          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "view_id": {
              "const": "view_balcony_left_overview"
            },
            "field": {
              "enum": [
                "people_count",
                "people_descriptions"
              ]
            }
          },
          "required": [
            "view_id",
            "field"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "view_id": {
              "const": "view_bathroom_upper_from_entry"
            },
            "field": {
              "enum": [
                "people_count",
                "people_descriptions"
              ]
            }
          },
          "required": [
            "view_id",
