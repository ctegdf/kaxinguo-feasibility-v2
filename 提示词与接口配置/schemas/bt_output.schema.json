              ]
            }
          },
          "required": [
            "view_id",
            "field"
          ],
          "additionalProperties": false
        }
      ]
    },
    "predicate": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "op": {
              "enum": [
                "EQ",
                "GT",
                "LT"
              ]
            },
            "left": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "boolean"
                },
                {
                  "type": "string"
                },
                {
                  "$ref": "#/$defs/result_ref"
                }
              ]
            },
            "right": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "boolean"
                },
                {
                  "type": "string"
                },
                {
                  "$ref": "#/$defs/result_ref"
                }
              ]
            }
          },
          "required": [
            "op",
            "left",
            "right"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "enum": [
                "AND",
                "OR"
              ]
            },
            "conditions": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/predicate"
              },
              "minItems": 2
            }
          },
          "required": [
            "op",
            "conditions"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "NOT"
            },
            "condition": {
              "$ref": "#/$defs/predicate"
            }
          },
          "required": [
            "op",
            "condition"
          ],
          "additionalProperties": false
        }
      ]
    },
    "reply_spec": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "LOCATION"
            },
            "allowed_location_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "bedroom_top_left",
                  "bedroom_top_center",
                  "study_top_right",
                  "kitchen_left_upper",
                  "balcony_left",
                  "bathroom_left_middle_upper",
                  "bathroom_left_middle_lower",
                  "bedroom_bottom_left",
                  "dining_area_top_center",
                  "central_hall_center",
                  "living_room_bottom_center",
                  "balcony_bottom",
                  "home_entry_right"
                ]
              },
              "minItems": 2,
              "uniqueItems": true
            }
          },
          "required": [
            "kind",
            "allowed_location_ids"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "CONTINUE_OR_STOP"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "TARGET_REF"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        }
      ]
    },
    "result_ref": {
      "type": "object",
      "properties": {
        "ref": {
          "type": "object",
          "properties": {
            "node_id": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_]*$",
              "maxLength": 64
            },
            "path": {
              "enum": [
                [
                  "data",
                  "value"
                ],
                [
                  "data",
                  "summary"
                ],
                [
                  "data",
                  "arrived_location_id"
                ],
                [
                  "data",
                  "spoken_text"
                ],
                [
                  "data",
                  "raw_text"
                ]
              ]
            }
          },
          "required": [
            "node_id",
            "path"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "ref"
      ],
      "additionalProperties": false
    },
    "text_expr": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "$ref": "#/$defs/result_ref"
        },
        {
          "type": "object",
          "properties": {
            "concat": {
              "type": "array",
              "items": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "$ref": "#/$defs/result_ref"
                  }
                ]
              },
              "minItems": 1
            }
          },
          "required": [
            "concat"
          ],
          "additionalProperties": false
        }
      ]
    },
    "tree": {
      "type": "object",
      "properties": {
        "task_name": {
          "type": "string",
          "minLength": 1
        },
        "root_id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$",
          "maxLength": 64
        },
        "nodes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          },
          "minItems": 2,
          "maxItems": 256
        }
      },
      "required": [
        "task_name",
        "root_id",
        "nodes"
      ],
      "additionalProperties": false
    }
  }
}
