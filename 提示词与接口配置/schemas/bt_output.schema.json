          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "view_id": {
              "const": "view_study_top_right_overview"
            },
            "field": {
              "enum": [
                "people_count",
                "people_descriptions",
                "cup_visible",
                "quiet_sign_visible",
                "visible_items"
              ]
            }
          },
          "required": [
            "view_id",
            "field"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "view_id": {
              "const": "view_kitchen_overview"
            },
            "field": {
              "enum": [
                "people_count",
                "people_descriptions"
              ]
            }
          },
          "required": [
