            "field": {
              "enum": [
                "people_count",
                "people_descriptions"
              ]
            }
          },
          "required": [
            "view_id",
            "field"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "view_id": {
              "const": "view_dining_area_overview"
            },
            "field": {
              "enum": [
                "people_count",
                "people_descriptions",
                "tableware_visible"
              ]
            }
          },
          "required": [
            "view_id",
            "field"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "view_id": {
              "const": "view_living_room_overview"
            },
            "field": {
              "enum": [
                "people_count",
                "people_descriptions"
              ]
            }
          },
          "required": [
            "view_id",
